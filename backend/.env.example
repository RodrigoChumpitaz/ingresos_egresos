# Modo de almacenamiento: 'memory' (demo local sin BD) o 'mongo' (MongoDB Atlas o Docker)
STORAGE_MODE=memory
# Cadena de conexión de MongoDB Atlas o Docker local (mongodb://localhost:27017)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Nombre de la base de datos que usará esta API
MONGODB_DB_NAME=ingreso_egresos
# Puerto para desarrollo local (Vercel lo ignora)
PORT=3000
# Secreto HMAC para firmar cookies de sesión (mínimo 32 caracteres en producción)
AUTH_SECRET=cambia-este-secreto-por-uno-seguro-de-32-caracteres
# Orígenes permitidos para CORS separados por coma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
